# DocMind backend configuration.
# Copy to `.env` and fill in real values. All variables are required unless
# marked optional. See README.md → Configuration for descriptions.

DATABASE_URL=postgresql://docmind1234:docmind123@localhost:5432/docmind
SECRET_KEY=change-me-to-a-long-random-string
EXPIRE_MINUTES=30
ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/0

# Google Gemini API key (embeddings + chat completions)
GEMINI_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery: "resend" or "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_FROM=DocMind <onboarding@resend.dev>